# Copiar como .env para desarrollo local (netlify dev) y configurar
# las mismas variables en Netlify: Site configuration > Environment variables

# Cadena de conexión de PostgreSQL (Neon: Dashboard > Connection string)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/bookstore?sslmode=require

# URL AMQP de CloudAMQP (Instance > Details > AMQP URL)
CLOUDAMQP_URL=amqps://usuario:password@host.rmq.cloudamqp.com/vhost

# Opcional: URL del backend que usan las funciones *Tasks para invocar las *Batch.
# En Netlify no hace falta (se usa la variable URL del sitio).
# API_URL=http://localhost:8888
